#!/usr/bin/env sh
# Run the fleet CLI from this folder: ./ocfleet doctor
# Symlinks are resolved first, so this still works when it is linked into
# ~/.local/bin — otherwise dirname would point at the link, not at the repo.
target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case $link in
    /*) target=$link ;;
    *)  target=$(dirname "$target")/$link ;;
  esac
done
dir=$(cd "$(dirname "$target")" && pwd)
exec node "$dir/bin/ocfleet.mjs" "$@"
