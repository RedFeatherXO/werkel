# Copy to .env next to docker-compose.yml and fill in.
# Generate a token:  openssl rand -hex 24
WERKEL_INGEST_TOKEN=change-me

# Leave both empty for a LAN dashboard without a login.
# Set both to require a browser login (works alongside the token above).
DASHBOARD_USER=
DASHBOARD_PASS=

RETENTION_JOBS=300
TZ=Europe/Berlin

# Report on THIS machine's jobs from inside the server, every N seconds.
# Off by default: this server normally runs where the jobs are not. On the
# machine with the jobs, `werkel dashboard` already does both.
# REPORT_SELF_SEC=5
