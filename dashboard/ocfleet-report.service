# Reporter for the machine that runs the jobs.
#   sudo cp ocfleet-report.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ocfleet-report
# Adjust User, the two paths and the dashboard URL first.
[Unit]
Description=opencode-fleet reporter (pushes job state to the dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meik
Environment=FLEET_INGEST_TOKEN=change-me
ExecStart=/home/meik/.nvm/versions/node/v20.20.2/bin/node /home/meik/Programs/MCP-Servers/opencode-fleet/bin/ocfleet.mjs report --to http://minipc:7777 --interval 5
Restart=always
RestartSec=10
# it only reads the fleet state and talks to one host
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
